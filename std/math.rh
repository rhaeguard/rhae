func abs do
	x<

	x> 0 < if
		x> -1 * x<
	end

	x>
end

func pow_loop do	
	// calculates a^n
	n<
	a<

	1 out<

	loop n> 0 > do
		a> out> * out<
		n> -- n<
	end

	out>
end

func pow do	
	// calculates a^n
	y<
	x<

	x> ln
	y> *
	exp
end


func sin do
	// approx using maclaurin series
	x< // radian

	0.166666666667 f3<	// ~1/3!
	0.008333333333 f5<	// ~1/5!
	0.000198412698 f7<	// ~1/7!
	0.000002755732 f9<	// ~1/9!
	0.000000025053 f11<	// ~1/11!
	0.000000000161 f13<	// ~1/13!

	x> 3 pow_loop f3> * c1<
	x> 5 pow_loop f5> * c2<
	x> 7 pow_loop f7> * c3<
	x> 9 pow_loop f9> * c4<
	x> 11 pow_loop f11> * c5<
	x> 13 pow_loop f13> * c6<

	x> c1> -
	c2> +
	c3> -
	c4> +
	c5> -
	c6> +
end

func cos do
	// approx using maclaurin series
	x< // radian

	0.500000000000 f2<	// ~1/2!
	0.041666666667 f4<	// ~1/4!
	0.001388888889 f6<	// ~1/6!
	0.000024801587 f8<	// ~1/8!
	0.000000275573 f10<	// ~1/10!
	0.000000002088 f12<	// ~1/12!

	x> 2 pow_loop f2> * c1<
	x> 4 pow_loop f4> * c2<
	x> 6 pow_loop f6> * c3<
	x> 8 pow_loop f8> * c4<
	x> 10 pow_loop f10> * c5<
	x> 12 pow_loop f12> * c6<

	1 c1> -
	c2> +
	c3> -
	c4> +
	c5> -
	c6> +
end

func exp do
	// approx using maclaurin series
	x<

	0.500000000000 f2<	// ~1/2!
	0.166666666667 f3<	// ~1/3!
	0.041666666667 f4<	// ~1/4!
	0.008333333333 f5<	// ~1/5!
	0.001388888889 f6<	// ~1/6!
	0.000198412698 f7<	// ~1/7!
	0.000024801587 f8<	// ~1/8!
	0.000002755732 f9<	// ~1/9!
	0.000000275573 f10<	// ~1/10!
	0.000000025053 f11<	// ~1/11!
	0.000000002088 f12<	// ~1/12!
	0.000000000161 f13<	// ~1/13!

	x> 2 pow_loop f2> * c1<
	x> 3 pow_loop f3> * c2<
	x> 4 pow_loop f4> * c3<
	x> 5 pow_loop f5> * c4<
	x> 6 pow_loop f6> * c5<
	x> 7 pow_loop f7> * c6<
	x> 8 pow_loop f8> * c7<
	x> 9 pow_loop f9> * c8<
	x> 10 pow_loop f10> * c9<
	x> 11 pow_loop f11> * c10<
	x> 12 pow_loop f12> * c11<
	x> 13 pow_loop f13> * c12<

	1 x> +
	c1> +
	c2> +
	c3> +
	c4> +
	c5> +
	c6> +
	c7> +
	c8> +
	c9> +
	c10> +
	c11> +
	c12> +
end

func ln do
	// computing natural log by reduction
	// e.g., ln(89) = ln(44.5) + ln(2) = ln(89/4) + 2 ln(2) = ... = ln(89/26) + 6 ln(2) = ln(1.390625) + 6 ln(2)
	// ln(1.390625) is something we can compute with maclaurin series, and ln(2) can be approximated as well
	a<

	0 t<
	loop a> 2 > do
		a> 2 / a<
		t> ++ t<
	end

	0.6931471805599 LN2<

	t> LN2> *
	a> logN +
end

func logN do
	a<
	// assuming |x| < 1, x = 1
	a> 1 - x<

	0.500000000000 i2< 		// 1/2
	0.333333333333 i3< 		// 1/3
	0.250000000000 i4< 		// 1/4
	0.200000000000 i5< 		// 1/5
	0.166666666667 i6< 		// 1/6
	0.142857142857 i7< 		// 1/7
	0.125000000000 i8< 		// 1/8
	0.111111111111 i9< 		// 1/9
	0.100000000000 i10< 	// 1/10

	x> 2 pow_loop i2> * c2<
	x> 3 pow_loop i3> * c3<
	x> 4 pow_loop i4> * c4<
	x> 5 pow_loop i5> * c5<
	x> 6 pow_loop i6> * c6<
	x> 7 pow_loop i7> * c7<
	x> 8 pow_loop i8> * c8<
	x> 9 pow_loop i9> * c9<
	x> 10 pow_loop i10> * c10<

	x>
	c2> -
	c3> +
	c4> -
	c5> +
	c6> -
	c7> +
	c8> -
	c9> +
	c10> -
end