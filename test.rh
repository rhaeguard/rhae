"<--string-->" println

"heLlO" toUpper println
"heLlO" toLower println
"heLlO" toCapital println
"heLlO" len println
"   heLlO   " trim println
"   heLlO   " isEmpty println
"          " isEmpty println
"" isEmpty println
"   heLlO   " isBlank println
"          " isBlank println
"" isBlank println
"hello " "world" cat println

"---start/endswith---" println
"hello" "dest" startsWith println
"hello" "hell" startsWith println
"xtest" "dest" endsWith println
"hello" "ello" endsWith println

