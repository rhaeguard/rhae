"a quick brown fox jumps over lazy dog" chars unsorted<
unsorted> 0 unsorted> size -- qsort str print "|" println

"a quick brown fox jumps over lazy dog" chars unsorted<
:clear unsorted> 0 unsorted> size -- msort str print ">" println

