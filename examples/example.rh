"--funcsfuncs---" println

func sumTill do // int -> int
    dup 1 + * 2 /
end

func euler do
    333 sumTill 3 *
    199 sumTill 5 *
    +
    66 sumTill 15 *
    -
    println
end

euler

"--factorial--" println

func fact do 
	dup 1 <= if
        1 *
    else
        dup 1 - fact *
    end
end

"Factorial of numbers from 1 to 7" println
1 fact println
2 fact println
3 fact println
4 fact println
5 fact println
6 fact println
7 fact println

"We can chain factorial calls" println
3 fact fact println

"Fibonacci" println
func fib do dup 1 <= if
        dup 0 <= if
            drop 0
        else
            drop 1
        end
    else
        1 - dup 1 - fib swap fib +
    end
end

0 fib println
1 fib println
2 fib println
3 fib println
4 fib println
5 fib println
6 fib println

